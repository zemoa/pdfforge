{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-start-dragging",
    "core:window:allow-start-resize-dragging",
    "core:window:allow-toggle-maximize",
    "dialog:allow-open",
    "allow-resolve-pasted-destination-folder",
    "allow-inspect-merge-sources",
    "allow-preview-merge-output",
    "allow-start-merge",
    "allow-cancel-merge",
    "allow-inspect-redaction-source",
    "allow-render-redaction-page",
    "allow-preview-redaction-output",
    "allow-start-redaction",
    "allow-cancel-redaction",
    "allow-inspect-split-source",
    "allow-render-split-thumbnails",
    "allow-preview-split-output",
    "allow-start-split",
    "allow-cancel-split",
    "allow-update-status",
    "allow-check-for-update",
    "allow-start-update",
    "allow-cancel-update",
    "allow-restore-previous-update"
  ]
}
